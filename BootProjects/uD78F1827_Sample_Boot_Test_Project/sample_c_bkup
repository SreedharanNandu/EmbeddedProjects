void samFslEnd( void )
{
    /* Declares the end of flash self programming */
    FSL_Close();
}



fsl_u08 samTestOpen( void )
{
    fsl_u08 st;
    FSL_Open();
    st = FSL_Init( fsl_data_buffer );
    while( st == FSL_ERR_INTERRUPTION )
    {
        st = FSL_Init_cont( fsl_data_buffer );
    }
    if( st == FSL_OK )
    {
        st = FSL_ModeCheck();
    }
    return st;
}

void samTestErase( void )
{
    gInitSt = gBlankBefore = gEraseSt = gBlankAfter = 0xEE;
    gInitSt = samTestOpen();
    if( gInitSt == FSL_OK )
    {
        do { gBlankBefore = FSL_BlankCheck( TEST_BLOCK ); }
        while( gBlankBefore == FSL_ERR_INTERRUPTION );

        do { gEraseSt = FSL_Erase( TEST_BLOCK ); }
        while( gEraseSt == FSL_ERR_INTERRUPTION );

        do { gBlankAfter = FSL_BlankCheck( TEST_BLOCK ); }
        while( gBlankAfter == FSL_ERR_INTERRUPTION );
    }
    FSL_Close();
}

void samTestWrite( void )
{
    fsl_u08 k;
    fsl_u16 i;

    gVerifySt = 0xEE;
    for( k = 0; k < 4; k++ ) { gWriteSt[ k ] = 0xEE; }

    gInitSt = samTestOpen();
    if( gInitSt == FSL_OK )
    {
        for( k = 0; k < 4; k++ )
        {
            for( i = 0; i < 256; i++ )
            {
                fsl_data_buffer[ i ] = (fsl_u08)i;      /* 00 01 02 ... FF */
            }
            do { gWriteSt[ k ] = FSL_Write( TEST_ADDR + ( (fsl_u32)k * 256UL ), 64 ); }
            while( gWriteSt[ k ] == FSL_ERR_INTERRUPTION );
            if( gWriteSt[ k ] != FSL_OK ) { break; }
